# Backend-Environment (Django)
# Kopiere diese Datei nach `.env` und passe Werte bei Bedarf an.

# --- Django ---
# Geheimer Schlüssel; in Production zwingend ersetzen.
DJANGO_SECRET_KEY=dev-only-not-secret-change-me
# Debug-Modus, in Production zwingend false.
DJANGO_DEBUG=true
# Komma-separierte Liste, z.B. "localhost,127.0.0.1".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Welche Settings-Datei geladen wird: backend.settings.dev / .test / .prod
DJANGO_SETTINGS_MODULE=backend.settings.dev

# --- Datenbank ---
# Muss zur docker-compose-DB passen.
DATABASE_URL=postgres://buchung:buchung_dev@localhost:5432/buchung

# --- CORS ---
# Komma-separierte Liste von Origins, die das Backend ansprechen dürfen.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- JWT (Admin-Auth, ab M4) ---
# Lebensdauer der Tokens in Minuten bzw. Tagen.
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- I18n ---
DJANGO_LANGUAGE_CODE=de
DJANGO_TIME_ZONE=Europe/Zurich
